{
  "$schema_note": "nexvul design tokens. Single source of truth for the terminal reporter, the HTML report, SARIF severity values and fixed copy. Proposed (Phase 0); values marked here are design targets, not implemented. Contrast ratios are WCAG 2.2 against color.<theme>.surface.card unless stated.",
  "version": "0.1.0-design",
  "color": {
    "dark": {
      "surface": { "page": "#0c0e14", "raised": "#13161f", "card": "#191d29", "card_hover": "#1e2333", "inset": "#0f1119" },
      "border": { "default": "#252a3a", "subtle": "#1c2030" },
      "text": {
        "default": { "value": "#e2e4ea", "contrast": 13.22 },
        "muted": { "value": "#8890a4", "contrast": 5.26 },
        "dim": { "value": "#80889d", "contrast": 4.7, "use": "metadata only; never the only carrier of meaning" }
      },
      "accent": { "fill": "#6c8aff", "text": { "value": "#8aa4ff", "contrast": 7.07 }, "tint": "rgba(108, 138, 255, 0.15)" },
      "severity": {
        "critical": { "text": "#ff6b85", "contrast": 6.16, "tint": "rgba(255, 107, 133, 0.10)", "border": "rgba(255, 107, 133, 0.30)" },
        "high": { "text": "#ff9d57", "contrast": 8.18, "tint": "rgba(255, 157, 87, 0.10)", "border": "rgba(255, 157, 87, 0.30)" },
        "medium": { "text": "#f0c541", "contrast": 10.22, "tint": "rgba(240, 197, 65, 0.10)", "border": "rgba(240, 197, 65, 0.30)" },
        "low": { "text": "#6cb6ff", "contrast": 7.82, "tint": "rgba(108, 182, 255, 0.10)", "border": "rgba(108, 182, 255, 0.30)" },
        "info": { "text": "#a3abbf", "contrast": 7.31, "tint": "rgba(163, 171, 191, 0.08)", "border": "rgba(163, 171, 191, 0.25)" }
      },
      "status": {
        "complete": { "text": "#e2e4ea", "note": "neutral ink; never green" },
        "partial": { "fill": "#f0c541", "on_fill": "#14161c", "on_fill_contrast": 10.99, "pattern": "hatch-45" },
        "failed": { "fill": "#c41d3a", "on_fill": "#ffffff", "on_fill_contrast": 5.86, "pattern": "none" }
      },
      "flow": { "source_marker": "#d58cff", "sink_marker": "#f0c541" }
    },
    "light": {
      "surface": { "page": "#f5f6f8", "raised": "#ffffff", "card": "#ffffff", "card_hover": "#f8f9fb", "inset": "#f0f1f4" },
      "border": { "default": "#dfe1e8", "subtle": "#eaedf2" },
      "text": {
        "default": { "value": "#1a1d27", "contrast": 16.81 },
        "muted": { "value": "#5b6270", "contrast": 6.13 },
        "dim": { "value": "#636a77", "contrast": 5.44 }
      },
      "accent": { "fill": "#4a6cf7", "text": { "value": "#3654dc", "contrast": 6.07 }, "tint": "rgba(74, 108, 247, 0.08)" },
      "severity": {
        "critical": { "text": "#c41d3a", "contrast": 5.86, "tint": "rgba(196, 29, 58, 0.06)", "border": "rgba(196, 29, 58, 0.25)" },
        "high": { "text": "#a64c08", "contrast": 5.74, "tint": "rgba(166, 76, 8, 0.06)", "border": "rgba(166, 76, 8, 0.25)" },
        "medium": { "text": "#8a6100", "contrast": 5.54, "tint": "rgba(138, 97, 0, 0.06)", "border": "rgba(138, 97, 0, 0.25)" },
        "low": { "text": "#1f5fb8", "contrast": 6.2, "tint": "rgba(31, 95, 184, 0.06)", "border": "rgba(31, 95, 184, 0.25)" },
        "info": { "text": "#5b6474", "contrast": 5.97, "tint": "rgba(91, 100, 116, 0.06)", "border": "rgba(91, 100, 116, 0.20)" }
      },
      "status": {
        "complete": { "text": "#1a1d27", "note": "neutral ink; never green" },
        "partial": { "fill": "#f0c541", "on_fill": "#14161c", "on_fill_contrast": 10.99, "pattern": "hatch-45" },
        "failed": { "fill": "#c41d3a", "on_fill": "#ffffff", "on_fill_contrast": 5.86, "pattern": "none" }
      },
      "flow": { "source_marker": "#8a2bb8", "sink_marker": "#8a6100" }
    }
  },
  "severity": {
    "order": ["critical", "high", "medium", "low", "info"],
    "critical": { "label": "CRITICAL", "meter": "████", "meter_ascii": "[####]", "security_severity": "9.5", "sarif_level": "error", "terminal_sgr": "1;97;41", "fails_at_default_threshold": true },
    "high": { "label": "HIGH", "meter": "███░", "meter_ascii": "[###.]", "security_severity": "8.0", "sarif_level": "error", "terminal_sgr": "1;31", "fails_at_default_threshold": true },
    "medium": { "label": "MEDIUM", "meter": "██░░", "meter_ascii": "[##..]", "security_severity": "5.5", "sarif_level": "warning", "terminal_sgr": "33", "fails_at_default_threshold": false },
    "low": { "label": "LOW", "meter": "█░░░", "meter_ascii": "[#...]", "security_severity": "3.0", "sarif_level": "note", "terminal_sgr": "34", "fails_at_default_threshold": false },
    "info": { "label": "INFO", "meter": "░░░░", "meter_ascii": "[....]", "security_severity": null, "sarif_level": null, "terminal_sgr": "2", "fails_at_default_threshold": false, "note": "never uploaded to SARIF; never fails a build" }
  },
  "confidence": {
    "levels": ["high", "medium", "low"],
    "display": "word only, never a number",
    "sarif_precision": { "high": "high", "medium": "medium", "low": "low" },
    "low_default": "off"
  },
  "status": {
    "complete": { "word": "COMPLETE", "terminal_sgr": "1", "exit_code_family": [0, 1] },
    "partial": { "word": "PARTIAL SCAN", "terminal_sgr": "1;30;43", "exit_code": 3 },
    "failed": { "word": "SCAN FAILED", "terminal_sgr": "1;97;41", "exit_code": 3 }
  },
  "terminal": {
    "rule_char": "─",
    "rule_char_ascii": "-",
    "separator_dot": "·",
    "separator_dot_ascii": "-",
    "accent_sgr": "36",
    "dim_sgr": "2",
    "bold_sgr": "1",
    "source_word_sgr": "35",
    "sink_word_sgr": "33",
    "body_wrap_max": 100,
    "narrow_breakpoint": 80,
    "min_wrapped_width": 40,
    "default_width_unknown": 100,
    "color_disabled_when": ["NO_COLOR set (any value)", "--no-color", "TERM=dumb", "stdout is not a TTY"],
    "color_forced_when": ["--color=always", "FORCE_COLOR set (only if NO_COLOR is not set)"],
    "ascii_when": ["output encoding is not UTF-8", "NEXVUL_ASCII=1"],
    "osc8_links": "local file:// paths built by nexvul only; off when not a TTY or in CI"
  },
  "type": {
    "family": {
      "mono": "ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace",
      "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    },
    "note": "System fonts only. The HTML report loads no fonts (no network, CSP default-src 'none').",
    "scale_px": { "xs": 11, "sm": 12, "base": 14, "md": 16, "lg": 20, "xl": 28 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "line_height": { "tight": 1.2, "body": 1.5, "code": 1.7 },
    "numerals": "tabular-nums for all counts",
    "label_case": "UPPERCASE with 0.06em tracking for section labels and severity labels"
  },
  "space_px": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40 },
  "radius_px": { "sm": 4, "md": 8, "lg": 12 },
  "layout": {
    "report_max_width_px": 1120,
    "report_gutter_px": { "desktop": 24, "narrow": 16 },
    "report_narrow_breakpoint_px": 600,
    "touch_target_min_px": 44,
    "snippet_max_lines": 3,
    "inline_skip_paths_max": 5,
    "html_skip_paths_max": 50,
    "verbose_skip_paths_max": 200,
    "job_summary_rows_max": 50
  },
  "motion": {
    "report_transition_ms": 150,
    "easing": "ease-out",
    "reduced_motion": "all transitions 0ms under prefers-reduced-motion: reduce",
    "terminal_spinner": "none; progress is a counter, redrawn at most 10 times per second, stderr only"
  },
  "truncation": {
    "path_display_max": 120,
    "identifier_in_message_max": 80,
    "justification_display_max": 120,
    "message_text_max": 400,
    "ellipsis": "…",
    "ellipsis_ascii": "...",
    "hash_suffix": "first 6 hex of sha256 of the full value, in brackets"
  },
  "copy": {
    "disclaimer": "A clean nexvul result does not prove that an application is secure.",
    "no_findings_complete": "No findings from enabled rules. This does not prove the application is secure.",
    "no_findings_partial": "No findings in the {analysed} files that were analysed. {not_analysed} files were not analysed.",
    "partial_banner": "PARTIAL SCAN — {not_analysed} of {discovered} files not analysed. This result is not a clean bill of health.",
    "failed_banner": "SCAN FAILED — {cause}",
    "control_absence_qualifier": "in the scanned code; controls outside this repository are not visible to nexvul",
    "finding_meaning": "A finding means nexvul identified a risky pattern. It does not prove the code is exploitable.",
    "doctor_scope": "This checks nexvul's installation, not your code."
  }
}
