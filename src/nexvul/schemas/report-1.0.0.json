{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexvul/schemas/report-1.0.0.json",
  "title": "nexvul JSON report",
  "description": "Shipped with nexvul; never fetched at run time (SR-23). completeness is required (threat model section 7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nexvul",
    "scan",
    "config",
    "completeness",
    "summary",
    "findings",
    "suppressed",
    "suppressions",
    "analysis_limited",
    "untrusted_fields"
  ],
  "properties": {
    "nexvul": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_format",
        "schema_version",
        "version",
        "rule_pack",
        "python",
        "platform",
        "parsers",
        "plugins_loaded"
      ],
      "properties": {
        "report_format": {
          "const": "nexvul-json"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "version": {
          "type": "string"
        },
        "rule_pack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "sha256",
            "rules"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "rules": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "parsers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plugins_loaded": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "mode",
        "commit",
        "started_at",
        "ended_at",
        "ci",
        "ci_reason",
        "scope",
        "position_encoding"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "git",
            "directory"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string"
        },
        "ended_at": {
          "type": "string"
        },
        "ci": {
          "type": "boolean"
        },
        "ci_reason": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "repository",
            "explicit-paths"
          ]
        },
        "position_encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line_base",
            "column_base",
            "column_unit"
          ],
          "properties": {
            "line_base": {
              "const": 1
            },
            "column_base": {
              "const": 1
            },
            "column_unit": {
              "const": "utf8_bytes"
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective",
        "sources",
        "changes"
      ],
      "properties": {
        "effective": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value",
              "sources"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "path",
              "sha256",
              "ref"
            ],
            "properties": {
              "source": {
                "enum": [
                  "cli",
                  "user",
                  "base_ref",
                  "repo",
                  "default"
                ]
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "detail",
              "source",
              "status",
              "reason"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "applied",
                  "not_applied"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "failed_cause",
        "files_discovered",
        "files_analysed",
        "files_not_analysed",
        "files_failed",
        "files_timed_out",
        "files_skipped",
        "files_skipped_truncated",
        "skipped_by_reason",
        "limits_hit",
        "analysis_budgets_exhausted",
        "rule_failures",
        "findings_truncated",
        "suppressed",
        "protections_weakened_by_repo_config",
        "config_sources",
        "plugins_loaded",
        "dynamic_constructs_not_analysed",
        "allow_partial",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "failed_cause": {
          "enum": [
            "nothing_to_analyse",
            "none_analysed",
            null
