                  "experimental"
                ],
                "precision": "high",
                "security-severity": "8.0",
                "nexvul": {
                  "readiness": "experimental",
                  "asi": [
                    "ASI07",
                    "ASI04"
                  ],
                  "cwe": [
                    "CWE-319",
                    "CWE-306"
                  ],
                  "default_severity": "high",
                  "confidence_ceiling": "high",
                  "languages": [
                    "json",
                    "python"
                  ]
                }
              }
            }
          ],
