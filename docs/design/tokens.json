    "_app_note": "color.<theme>.app holds app-shell values added for the v1 dashboard (DEC-0009): partial hatch stripe, card shadow, narrow-menu scrim, the 'design mock-up' band, and agent-map graph strokes. mock_band_text contrast on mock_band: light 7.6, dark 9.4."
  },
  "severity": {
    "order": [
      "critical",
      "high",
      "medium",
      "low",
      "info"
    ],
    "critical": {
      "label": "CRITICAL",
      "meter": "████",
      "meter_ascii": "[####]",
      "security_severity": "9.5",
      "sarif_level": "error",
      "terminal_sgr": "1;97;41",
      "fails_at_default_threshold": true
    },
    "high": {
      "label": "HIGH",
      "meter": "███░",
      "meter_ascii": "[###.]",
      "security_severity": "8.0",
      "sarif_level": "error",
      "terminal_sgr": "1;31",
      "fails_at_default_threshold": true
    },
    "medium": {
      "label": "MEDIUM",
      "meter": "██░░",
      "meter_ascii": "[##..]",
      "security_severity": "5.5",
      "sarif_level": "warning",
      "terminal_sgr": "33",
      "fails_at_default_threshold": false
    },
    "low": {
      "label": "LOW",
      "meter": "█░░░",
      "meter_ascii": "[#...]",
      "security_severity": "3.0",
      "sarif_level": "note",
      "terminal_sgr": "34",
      "fails_at_default_threshold": false
    },
    "info": {
      "label": "INFO",
      "meter": "░░░░",
      "meter_ascii": "[....]",
      "security_severity": null,
      "sarif_level": null,
      "terminal_sgr": "2",
      "fails_at_default_threshold": false,
      "note": "never uploaded to SARIF; never fails a build"
    }
  },
  "confidence": {
    "levels": [
      "high",
      "medium",
      "low"
    ],
    "display": "word only, never a number",
    "sarif_precision": {
      "high": "high",
      "medium": "medium",
      "low": "low"
    },
    "low_default": "off"
  },
  "status": {
    "complete": {
      "word": "COMPLETE",
      "terminal_sgr": "1",
      "exit_code_family": [
        0,
        1
      ]
    },
    "partial": {
      "word": "PARTIAL SCAN",
      "terminal_sgr": "1;30;43",
      "exit_code": 3
    },
    "failed": {
      "word": "SCAN FAILED",
      "terminal_sgr": "1;97;41",
      "exit_code": 3
    }
  },
  "terminal": {
    "rule_char": "─",
    "rule_char_ascii": "-",
    "separator_dot": "·",
    "separator_dot_ascii": "-",
    "accent_sgr": "36",
    "dim_sgr": "2",
    "bold_sgr": "1",
    "source_word_sgr": "35",
    "sink_word_sgr": "33",
    "body_wrap_max": 100,
    "narrow_breakpoint": 80,
    "min_wrapped_width": 40,
    "default_width_unknown": 100,
    "color_disabled_when": [
      "NO_COLOR set (any value)",
      "--no-color",
      "TERM=dumb",
      "stdout is not a TTY"
    ],
    "color_forced_when": [
      "--color=always",
      "FORCE_COLOR set (only if NO_COLOR is not set)"
    ],
    "ascii_when": [
      "output encoding is not UTF-8",
      "NEXVUL_ASCII=1"
    ],
    "osc8_links": "local file:// paths built by nexvul only; off when not a TTY or in CI"
  },
  "type": {
    "family": {
      "mono": "ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace",
      "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    },
    "note": "System fonts only. The HTML report loads no fonts (no network, CSP default-src 'none').",
    "scale_px": {
      "xs": 11,
      "sm": 12,
      "base": 14,
      "md": 16,
      "lg": 20,
      "xl": 28
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "line_height": {
      "tight": 1.2,
      "body": 1.5,
      "code": 1.7
    },
    "numerals": "tabular-nums for all counts",
    "label_case": "UPPERCASE with 0.06em tracking for section labels and severity labels"
  },
  "space_px": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40
  },
  "radius_px": {
    "sm": 4,
    "md": 8,
    "lg": 12
  },
  "layout": {
    "report_max_width_px": 1120,
    "report_gutter_px": {
      "desktop": 24,
      "narrow": 16
    },
    "report_narrow_breakpoint_px": 600,
    "touch_target_min_px": 44,
    "snippet_max_lines": 3,
    "inline_skip_paths_max": 5,
    "html_skip_paths_max": 50,
    "verbose_skip_paths_max": 200,
    "job_summary_rows_max": 50,
    "app_shell": {
      "nav_width_px": 232,
      "topbar_height_px": 56,
      "collapse_below_px": 900,
      "content_max_width_px": 1120
    }
  },
  "motion": {
    "report_transition_ms": 150,
    "easing": "ease-out",
    "reduced_motion": "all transitions 0ms under prefers-reduced-motion: reduce",
    "terminal_spinner": "none; progress is a counter, redrawn at most 10 times per second, stderr only"
  },
  "truncation": {
    "path_display_max": 120,
    "identifier_in_message_max": 80,
    "justification_display_max": 120,
    "message_text_max": 400,
    "ellipsis": "…",
    "ellipsis_ascii": "...",
    "hash_suffix": "first 6 hex of sha256 of the full value, in brackets"
  },
  "copy": {
    "disclaimer": "A clean nexvul result does not prove that an application is secure.",
    "no_findings_complete": "No findings from enabled rules. This does not prove the application is secure.",
    "no_findings_partial": "No findings in the {analysed} files that were analysed. {not_analysed} files were not analysed.",
    "partial_banner": "PARTIAL SCAN — {not_analysed} of {discovered} files not analysed. This result is not a clean bill of health.",
    "failed_banner": "SCAN FAILED — {cause}",
    "control_absence_qualifier": "in the scanned code; controls outside this repository are not visible to nexvul",
    "finding_meaning": "A finding means nexvul identified a risky pattern. It does not prove the code is exploitable.",
    "doctor_scope": "This checks nexvul's installation, not your code."
  },
  "storage": {
    "report_prefs_key": "nexvul.report.prefs",
    "scope": "this browser only (localStorage, wrapped in try/catch); never config, never source files",
    "fields": [
      "theme: system|light|dark",
      "density: comfortable|compact",
      "show_low_info: bool",
      "wrap_code: bool"
    ]
  }
}